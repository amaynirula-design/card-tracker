  "components": [
    {
      "name": "Primary Button (ground)",
      "kind": "button",
      "refersTo": "button-primary-ground",
      "description": "The main action on ultramarine: white with ink text.",
      "html": "<div class=\"ds-g\"><button class=\"ds-btn-pg\">Create account</button></div>",
      "css": ".ds-g{background:var(--ultramarine);color:#fff;padding:20px} .ds-btn-pg{font-family:var(--font-archivo),Archivo,system-ui,sans-serif;height:48px;padding:0 24px;border:0;border-radius:6px;background:#fff;color:var(--ink);font-weight:700;font-size:1rem;cursor:pointer;transition:background-color .15s} .ds-btn-pg:hover{background:#e3e6f7} .ds-btn-pg:focus-visible{outline:2px solid #fff;outline-offset:2px}"
    },
    {
      "name": "Primary Button (land)",
      "kind": "button",
      "refersTo": "button-primary-land",
      "description": "The same button on land: ultramarine with white text.",
      "html": "<div class=\"ds-l\"><button class=\"ds-btn-pl\">Save</button></div>",
      "css": ".ds-l{background:var(--pale);color:var(--ink);padding:20px} .ds-btn-pl{font-family:var(--font-archivo),Archivo,system-ui,sans-serif;height:44px;padding:0 16px;border:0;border-radius:6px;background:var(--ultramarine);color:#fff;font-weight:700;font-size:.875rem;cursor:pointer;transition:background-color .15s} .ds-btn-pl:hover{background:var(--ultramarine-deep)} .ds-btn-pl:focus-visible{outline:2px solid var(--ultramarine);outline-offset:2px}"
    },
    {
      "name": "Secondary Button (land)",
      "kind": "button",
      "refersTo": "button-secondary-land",
      "description": "A 1px outline in the current text color, for the other actions.",
      "html": "<div class=\"ds-l2\"><button class=\"ds-btn-sl\">Edit</button></div>",
      "css": ".ds-l2{background:var(--pale);color:var(--ink);padding:20px} .ds-btn-sl{font-family:var(--font-archivo),Archivo,system-ui,sans-serif;height:44px;padding:0 16px;border:1px solid currentColor;border-radius:6px;background:transparent;color:var(--ink);font-weight:700;font-size:.875rem;cursor:pointer;transition:background-color .15s} .ds-btn-sl:hover{background:#e3e6f7} .ds-btn-sl:focus-visible{outline:2px solid var(--ultramarine);outline-offset:2px}"
    },
    {
      "name": "Category Keys",
      "kind": "chip",
      "refersTo": "category-key",
      "description": "The grid of category codes. The selected key is the origin, so it is yellow.",
      "html": "<div class=\"ds-keys\"><button class=\"ds-key ds-key-on\" aria-pressed=\"true\">DIN</button><button class=\"ds-key\" aria-pressed=\"false\">GRO</button><button class=\"ds-key\" aria-pressed=\"false\">GAS</button><button class=\"ds-key\" aria-pressed=\"false\">TVL</button></div>",
      "css": ".ds-keys{background:var(--ultramarine);color:#fff;padding:20px;display:flex;gap:6px} .ds-key{font-family:var(--font-archivo),Archivo,system-ui,sans-serif;font-stretch:115%;font-weight:800;letter-spacing:.06em;text-transform:uppercase;height:44px;min-width:56px;border:0;border-radius:7px;background:rgb(255 255 255 / .14);color:#fff;font-size:.9375rem;cursor:pointer;transition:background-color .15s} .ds-key:hover{background:rgb(255 255 255 / .24)} .ds-key:focus-visible{outline:2px solid #fff;outline-offset:2px} .ds-key-on,.ds-key-on:hover{background:var(--winner);color:var(--ink)}"
    },
    {
      "name": "Row with Code Tags",
      "kind": "card",
      "refersTo": "card-tag",
      "description": "A land row: tag, name, and the value in the right-aligned column.",
      "html": "<ul class=\"ds-rows\"><li class=\"ds-row\"><span class=\"ds-tag\" style=\"background:var(--winner)\">AMG</span><span class=\"ds-t\">American Express Gold</span><span class=\"ds-v\">4%</span></li><li class=\"ds-row\"><span class=\"ds-tag\" style=\"background:#a8e05f\">CSP</span><span class=\"ds-t\">Chase Sapphire Preferred</span><span class=\"ds-v\">3.75%</span></li><li class=\"ds-row\"><span class=\"ds-tag\" style=\"background:#6fc8ff\">CIP</span><span class=\"ds-t\">Citi Strata Premier</span><span class=\"ds-v\">3%</span></li></ul>",
      "css": ".ds-rows{background:var(--pale);color:var(--ink);font-family:var(--font-archivo),Archivo,system-ui,sans-serif;list-style:none;margin:0;padding:20px} .ds-row{display:flex;align-items:center;gap:12px;min-height:56px;border-bottom:1px solid #c9cdea} .ds-tag{font-family:var(--font-archivo),Archivo,system-ui,sans-serif;font-stretch:115%;font-weight:800;letter-spacing:.06em;text-transform:uppercase;display:inline-flex;align-items:center;justify-content:center;height:28px;min-width:56px;padding:0 6px;border-radius:5px;font-size:.875rem;line-height:1;color:var(--ink)} .ds-t{flex:1;font-weight:600} .ds-v{font-weight:700;text-align:right;font-variant-numeric:tabular-nums}"
    },
    {
      "name": "Input",
      "kind": "input",
      "refersTo": "input",
      "description": "A bold label above a white box with a field-line border.",
      "html": "<div class=\"ds-f\"><label class=\"ds-lb\">Merchant<input class=\"ds-in\" placeholder=\"Trader Joe’s\"></label></div>",
      "css": ".ds-f{background:var(--pale);color:var(--ink);font-family:var(--font-archivo),Archivo,system-ui,sans-serif;padding:20px} .ds-lb{display:block;font-size:.875rem;font-weight:700} .ds-in{font-family:var(--font-archivo),Archivo,system-ui,sans-serif;display:block;margin-top:6px;width:100%;height:48px;padding:0 12px;border:1px solid var(--field-line);border-radius:6px;background:#fff;color:var(--ink);font-size:1rem} .ds-in::placeholder{color:#3a3f6b} .ds-in:focus-visible{outline:2px solid var(--ultramarine);outline-offset:2px}"
    },
    {
      "name": "Phone Tab Bar",
      "kind": "nav",
      "refersTo": "tab-bar",
      "description": "The white five-tab bar pinned to the bottom on phones. Active is ultramarine with a filled icon.",
      "html": "<nav class=\"ds-tabs\"><a class=\"ds-tab ds-tab-on\" href=\"#\" aria-current=\"page\"><svg viewBox=\"0 0 24 24\" width=\"24\" height=\"24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\"><path d=\"M5 17Q12 1 19 17\"/><circle cx=\"5\" cy=\"17\" r=\"2.5\" fill=\"currentColor\"/><circle cx=\"19\" cy=\"17\" r=\"2.5\" fill=\"currentColor\"/></svg>Best Card</a><a class=\"ds-tab\" href=\"#\"><svg viewBox=\"0 0 24 24\" width=\"24\" height=\"24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M12 3l2.8 5.7 6.2.9-4.5 4.4 1.1 6.2L12 17.3 6.4 20.2l1.1-6.2L3 9.6l6.2-.9z\"/></svg>Starred</a></nav>",
      "css": ".ds-tabs{font-family:var(--font-archivo),Archivo,system-ui,sans-serif;display:flex;background:#fff;border-top:1px solid #c9cdea} .ds-tab{flex:1;display:flex;flex-direction:column;align-items:center;gap:4px;padding:10px 0 8px;font-size:.6875rem;font-weight:600;line-height:1;font-stretch:88%;color:#3a3f6b;text-decoration:none;transition:color .15s} .ds-tab:hover{color:var(--ink)} .ds-tab-on{color:var(--ultramarine)} .ds-tab:focus-visible{outline:2px solid var(--ultramarine);outline-offset:-2px}"
    },
    {
      "name": "Route Map",
      "kind": "custom",
      "refersTo": "route-map",
      "description": "The signature: routes from a white origin along one percent axis, with one thick yellow winner.",
      "html": "<div class=\"ds-map\"><svg viewBox=\"0 0 390 250\" role=\"img\" aria-label=\"Dining, percent back by card\"><line x1=\"30\" x2=\"360\" y1=\"186\" y2=\"186\" stroke=\"rgb(255 255 255 / .28)\" stroke-width=\"1.5\"/><path class=\"ds-r\" d=\"M30 186Q120 76 210 186\" stroke=\"#c9a8ff\"/><path class=\"ds-r\" d=\"M30 186Q147 44 264 186\" stroke=\"#6fc8ff\"/><path d=\"M30 186Q165 21 300 186\" fill=\"none\" stroke=\"#ffd21f\" stroke-width=\"6\" stroke-linecap=\"round\"/><circle cx=\"30\" cy=\"186\" r=\"9\" fill=\"#fff\"/><circle cx=\"210\" cy=\"186\" r=\"6\" fill=\"#c9a8ff\"/><circle cx=\"264\" cy=\"186\" r=\"6\" fill=\"#6fc8ff\"/><circle cx=\"300\" cy=\"186\" r=\"9\" fill=\"#ffd21f\"/><text class=\"ds-rate\" x=\"165\" y=\"90\">4%</text><text class=\"ds-c\" x=\"30\" y=\"224\" fill=\"#fff\">DIN</text><text class=\"ds-c\" x=\"210\" y=\"224\" fill=\"#fff\">CDC</text><text class=\"ds-c\" x=\"300\" y=\"224\" fill=\"#ffd21f\">AMG</text></svg></div>",
      "css": ".ds-map{background:var(--ultramarine);color:#fff;padding:12px} .ds-map svg{display:block;width:100%} .ds-r{fill:none;stroke-width:2.5;stroke-linecap:round;stroke-dasharray:3 7;transition:stroke .2s,stroke-width .2s} .ds-rate{font-family:var(--font-archivo),Archivo,system-ui,sans-serif;font-size:38px;font-weight:800;font-stretch:112%;fill:#ffd21f;text-anchor:middle} .ds-c{font-family:var(--font-archivo),Archivo,system-ui,sans-serif;font-stretch:115%;font-weight:800;letter-spacing:.06em;text-transform:uppercase;font-size:15px;text-anchor:middle}"
    }
